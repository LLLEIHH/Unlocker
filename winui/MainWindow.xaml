<Window
    x:Class="Unlocker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        资源说明：XamlControlsResources 由 App.xaml 合并，{ThemeResource ...} 走框架控件样式字典。
        这一条以前在 M5.1 期间是坏的（手写 IXamlMetadataProvider 对一切类型返回 nullptr，
        框架实例化 XamlControlsResources 时拿不到元数据 → 启动 fail-fast），
        现已改为委托 XAML 编译器生成的 provider（见 winui/XamlTypeLookup.h）。
    -->
    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragOver="OnDragOver"
          Drop="OnDrop">

        <!--
            窄窗口适配：窗口最小 820x560 DIP（代码里用 OverlappedPresenter.PreferredMinimum{Width,Height} 设死）。
            宽度不足 980 DIP 时底部操作按钮退化为纯图标，避免六个按钮横向挤爆、把「重新扫描」顶出可视区。
            切换由代码在 RootGrid.SizeChanged 里做（ApplyNarrowLayout）—— 实测 AdaptiveTrigger
            在这个手写 XAML 胶水工程里不触发，别指望它。
        -->

        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：内容延伸进标题区，代码里调用 SetTitleBar -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE785;" FontSize="11" Foreground="White" />
                </Border>
                <TextBlock Text="Unlocker" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleBarSubtitle" Text="文件占用解除工具" FontSize="12" VerticalAlignment="Center" Margin="4,1,0,0"
                           MaxLines="1" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

        </Grid>

        <!-- 顶部横幅：被手动提权 / 规则表 fail-closed 时出现 -->
        <InfoBar x:Name="Banner"
                 Grid.Row="1"
                 Margin="12,2,12,0"
                 Severity="Warning"
                 IsOpen="False"
                 IsClosable="False"
                 Title="提示" />

        <!-- 工具栏（右侧留一格放语言切换） -->
        <Grid Grid.Row="2" Margin="12,6,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <Button x:Name="AddFileButton">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                    <TextBlock x:Name="AddFileText" Text="添加文件" />
                </StackPanel>
            </Button>
            <Button x:Name="AddFolderButton">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control,Shift" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    <TextBlock x:Name="AddFolderText" Text="添加文件夹" />
                </StackPanel>
            </Button>
            <Button x:Name="DeepScanButton">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" />
                    <TextBlock x:Name="DeepScanText" Text="管理员深扫" />
                </StackPanel>
            </Button>
            <CheckBox x:Name="ForceCheck" Content="强制模式" VerticalAlignment="Center" MinWidth="0" Margin="8,0,0,0" />
            <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>

            <!--
                语言切换 ZH/EN。
                没有放进标题栏：SetTitleBar 会把整块标题栏当拖拽区，连子元素上的点击都吞掉
                （实测点不动）。放在工具栏右端同样在右上角，且点击可靠。
            -->
            <Button x:Name="LangButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Padding="9,2"
                    MinWidth="0"
                    MinHeight="0"
                    FontSize="12"
                    ToolTipService.ToolTip="切换界面语言 / Switch interface language（Ctrl+L）">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="L" Modifiers="Control" />
                </Button.KeyboardAccelerators>
                <TextBlock x:Name="LangText" Text="ZH" FontSize="12" FontWeight="SemiBold" />
            </Button>
        </Grid>

        <!-- 文件卡片 -->
        <Border x:Name="FilesCard"
                Grid.Row="3"
                Margin="12,10,12,0"
                MinHeight="176"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,9,12,5" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HdrPath" Grid.Column="1" Text="路径" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="HdrSize" Grid.Column="2" Text="大小" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="HdrOwner" Grid.Column="3" Text="占用者" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="HdrFileState" Grid.Column="4" Text="状态" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <ListView x:Name="FileList"
                          Grid.Row="1"
                          SelectionMode="Extended"
                          SelectionChanged="OnFileSelectionChanged"
                          Padding="4,0,4,4">
                    <ListView.KeyboardAccelerators>
                        <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="OnSelectAll" />
                        <KeyboardAccelerator Key="Enter" Invoked="OnUnlockAccelerator" />
                        <KeyboardAccelerator Key="Delete" Invoked="OnRemoveFromListAccelerator" />
                        <KeyboardAccelerator Key="Delete" Modifiers="Control" Invoked="OnDeleteAccelerator" />
                    </ListView.KeyboardAccelerators>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="44" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- 空状态：拖放区提示 -->
                <StackPanel x:Name="EmptyHint"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                    <FontIcon Glyph="&#xE838;" FontSize="42" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="EmptyTitle" Text="把文件或文件夹拖到这里"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="EmptyDesc"
                               Text="也可以点击上方「添加文件 / 添加文件夹」，支持多选与混合拖入"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 进程卡片 -->
        <Border x:Name="ProcessesCard"
                Grid.Row="4"
                Margin="12,10,12,0"
                MinHeight="132"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,9,12,5" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HdrProc" Grid.Column="1" Text="进程" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="HdrPid" Grid.Column="2" Text="PID" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="HdrDesc" Grid.Column="3" Text="描述" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="HdrHandles" Grid.Column="4" Text="句柄" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="HdrProcState" Grid.Column="5" Text="状态" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <ListView x:Name="ProcessList" Grid.Row="1" SelectionMode="Single" Padding="4,0,4,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="40" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Border>

        <!-- 操作区 -->
        <Grid Grid.Row="5" Margin="12,12,12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                主操作按钮：品牌蓝 #2176BC 实底 + 白色图标/文字。
                注意 Fluent Button 的悬停/按下态走的是主题资源键（不是 Background 属性），
                只设 Background 的话一悬停就变回灰色，所以这里把四个态的背景/前景/描边一起覆盖。
            -->
            <Button x:Name="UnlockButton" Grid.Column="0" ToolTipService.ToolTip="解锁选择项（不删除文件）">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#2176BC" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1C67A6" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#175486" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#B7D2E6" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2176BC" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#1C67A6" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#175486" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#B7D2E6" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#F0F6FB" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE785;" FontSize="14" Foreground="White" />
                    <TextBlock x:Name="UnlockText" Text="解锁选择项" Visibility="Collapsed" Foreground="White" />
                </StackPanel>
            </Button>
            <Button x:Name="DeleteButton" Grid.Column="1" ToolTipService.ToolTip="解锁并删除选中项">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock x:Name="DeleteText" Text="解锁并删除" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="RenameButton" Grid.Column="2" ToolTipService.ToolTip="解锁并改名">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    <TextBlock x:Name="RenameText" Text="解锁并改名" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="MoveButton" Grid.Column="3" ToolTipService.ToolTip="解锁并移动到…">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                    <TextBlock x:Name="MoveText" Text="解锁并移动" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="CopyButton" Grid.Column="4" ToolTipService.ToolTip="解锁并复制到…">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    <TextBlock x:Name="CopyText" Text="解锁并复制" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="RescanButton" Grid.Column="6" ToolTipService.ToolTip="重新扫描（F5）">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock x:Name="RescanText" Text="重新扫描" Visibility="Collapsed" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 状态栏：进度条 + 状态文字 + 占用统计 -->
        <Grid Grid.Row="6" Margin="14,8,14,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="ScanProgress"
                         Grid.Column="0"
                         Width="120"
                         Height="3"
                         IsIndeterminate="True"
                         VerticalAlignment="Center"
                         Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Text="执行组件：未启动"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="SummaryText"
                       Grid.Column="2"
                       Text=""
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>
    </Grid>
</Window>
